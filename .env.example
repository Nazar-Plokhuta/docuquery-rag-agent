# ============================================================
# DocuQuery RAG Agent — Environment Configuration Template
# Copy this file to `.env` and fill in the actual values.
# NEVER commit `.env` to version control.
# ============================================================

# ---------- Application Runtime ----------
APP_ENV=development
APP_PORT=8000
# Docker Compose only: host port for the Next.js Studio UI (`web` service).
WEB_PORT=3000
LOG_LEVEL=INFO

# ---------- HTTP / CORS ----------
# Comma-separated browser origins allowed to call the API (the Next.js web console).
# Empty or unset disables CORS entirely (same-origin only).
CORS_ALLOW_ORIGINS=

# ---------- LLM (routed by LiteLLM) ----------
# Model names are LiteLLM identifiers; the provider is chosen by the prefix:
#   gpt-4o-mini | anthropic/claude-sonnet-4-5 | openrouter/<vendor>/<model>
#   openai/<model> (with OPENAI_BASE_URL, for vLLM / LocalAI / other gateways)
#
# A name WITHOUT a prefix (gpt-4o-mini, text-embedding-3-small) is routed to
# OpenAI and needs a real OPENAI_API_KEY. OPENAI_MODEL and EMBEDDING_MODEL are
# routed independently, so using OpenRouter for chat does not cover embeddings.
# With only an OPENROUTER_API_KEY, prefix both, e.g.:
#   OPENAI_MODEL=openrouter/google/gemini-2.5-flash
#   EMBEDDING_MODEL=openrouter/openai/text-embedding-3-small
# The API logs a startup warning for combinations that cannot work.
#
# EMBEDDING_MODEL fixes the vector space of the index: switching it to a model
# with different vectors (or dimensions) requires re-ingesting every document.
# openrouter/openai/text-embedding-3-small returns the same vectors as the bare
# OpenAI name, so moving between those two needs no re-ingestion.
OPENAI_API_KEY=sk-placeholder
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional: Custom OpenAI-compatible gateway (vLLM, LocalAI). Only applied to
# OpenAI-routed models; defaults to the official OpenAI platform when omitted.
# OPENAI_BASE_URL=http://localhost:8001/v1

# Optional: provider keys read directly by LiteLLM for non-OpenAI models.
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Drop request parameters a provider does not support instead of failing.
LITELLM_DROP_PARAMS=true

# ---------- Vector Store (ChromaDB) ----------
# Local mode (default, `uv run` and Compose): embedded Chroma persisting to a
# directory. Docker Compose overrides this with /app/data/chroma_db.
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# Remote mode: set CHROMA_HOST to use a standalone Chroma server instead; the
# persistence directory is then ignored. Leave unset for local mode.
#   - Docker Compose: CHROMA_HOST=chroma and start with `--profile chroma`
#   - Local `uv run`: point at any reachable server, e.g. CHROMA_HOST=localhost
# CHROMA_HOST=
CHROMA_PORT=8000

# ---------- Relational / Audit Store ----------
# SQLAlchemy async URL used by `uv run` (local development). Pick one:
#   PostgreSQL (needs a server, e.g. `docker compose ... up db`):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docuquery
#   SQLite (no server):
# DATABASE_URL=sqlite+aiosqlite:///./data/telemetry.db
#
# Docker Compose IGNORES DATABASE_URL: it builds the URL for the api container
# from the POSTGRES_* values below and always targets the `db` service.

# ---------- Docker Compose: data directory ownership ----------
# The api container writes the Chroma index into the bind-mounted data/ directory,
# which keeps its host owner's ids. Set these to that owner (`id -u` / `id -g`;
# typically 1000 on Linux) and rebuild with `--build`. Left at the image default
# (1001) on a host with different ids, the index is readable but not writable and
# ingestion fails with "attempt to write a readonly database". Not needed on
# Docker Desktop (macOS/Windows), which maps bind-mount ownership itself.
# APP_UID=1001
# APP_GID=1001

# ---------- Docker Compose: PostgreSQL service ----------
# Only read by docker/docker-compose.yml. Defaults match the values below.
# If the password contains URL-reserved characters (@ : / ?), percent-encode it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=docuquery
# Host port published for the db service (container port is always 5432).
# POSTGRES_PORT=5432
