# Core source tree
mkdir -p src/{api/routes,api/schemas,config,core/rag,ingestion,storage}
mkdir -p tests/{unit,integration}
mkdir -p data/{chroma_db,sample_docs}

# Preserve data folders in git while ignoring their runtime content
touch data/sample_docs/.gitkeep
touch data/chroma_db/.gitkeep

# Root placeholders
touch README.md
touch .env.example