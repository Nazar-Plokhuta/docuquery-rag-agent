# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# Source code and configuration files
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.html text eol=lf
*.sh text eol=lf

# Raw binary assets
*.pdf binary
*.docx binary
*.xlsx binary
*.png binary
*.jpg binary
*.db binary
*.sqlite3 binary