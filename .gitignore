# Byte-compiled / optimized / Pydantic cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environments & secrets
.env
.env.local
.venv/
env/
venv/
ENV/

# Data, vector storage & persistent SQLite
# `**/` keeps these ignored when the server is started from inside apps/api and
# the relative `./data/...` defaults resolve there instead of the repo root.
**/data/chroma_db/
**/data/*.db
**/data/*.sqlite3

# IDE & OS specific
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Docker / Logs
*.log

# Node / Next.js (apps/web)
node_modules/
.next/
.turbo/
